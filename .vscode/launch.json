{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Start Synovia AI Studio (Backend & Auto-Tunnel)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/auto_synovia_launcher.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⚡ Run FastAPI Backend Server Only",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
